# ═══════════════════════════════════════════════════════════════════
# 大模型应用多源证据分层安全评测平台（Evidence-Ladder）— Unified Configuration
# All services (backend, ShopBot, FinanceBot) read from this file.
# Copy to .env and fill in your values: cp .env.example .env
# ═══════════════════════════════════════════════════════════════════

# ─── Shared API credentials (used by ALL services) ───────────────
# Use an official vendor endpoint. Third-party relays swap or retire models
# without notice, which breaks reproducibility.
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.deepseek.com

# ─── Backend: security analysis engine ───────────────────────────
# Judge model (analyzes attack results, needs strong reasoning).
# DeepSeek retired `deepseek-chat` / `deepseek-reasoner` on 2026-07-24;
# current IDs are `deepseek-v4-flash` and `deepseek-v4-pro`.
OPENAI_MODEL=deepseek-v4-flash
# Generation model (generates attack variants, fast & cheap)
OPENAI_MINI_MODEL=deepseek-v4-flash
# Maximum elapsed seconds for each platform LLM request (judge/generation).
LLM_REQUEST_TIMEOUT_S=60
# Optional JSON object merged into every backend request body. DeepSeek V4 and
# Qwen3.5 default to thinking mode; disable it for deterministic judge calls:
# OPENAI_EXTRA_BODY_JSON={"thinking": {"type": "disabled"}}
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
CORS_ORIGINS=["http://localhost:5173"]
ALLOW_LOCALHOST_TARGETS=true
# Allow RFC1918 private IPs for Docker Compose internal networking.
# Set to true when running mock targets in the same compose project.
ALLOW_PRIVATE_TARGETS=false
# Where the backend reaches the bundled mock targets (sample adapters and the
# New Scan presets use these). Defaults fit a local run; docker-compose.yml
# already points them at the compose service names.
# MOCK_FINANCEBOT_URL=http://localhost:8001
# MOCK_SHOPBOT_URL=http://localhost:8002
# MOCK_MAILBOT_URL=http://localhost:8003

# ─── Backend: API authentication (Stage 1.1a, default-deny) ──────
# When AUTH_REQUIRED=true (default), every API request must carry
# header `X-API-Key: <APP_SECRET>`. Set AUTH_REQUIRED=false ONLY for
# local development. Production MUST keep it true.
AUTH_REQUIRED=true
# Required when AUTH_REQUIRED=true. Generate via:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Paste the generated value below before starting the backend or Docker Compose.
# Empty APP_SECRET with AUTH_REQUIRED=true intentionally refuses startup.
APP_SECRET=

# ─── Mock targets: MailBot, ShopBot & FinanceBot ─────────────────
# Chat model for target AI bots (cheap model is fine)
TARGET_MODEL=deepseek-v4-flash
# Optional JSON object merged into every target request body (MailBot/ShopBot).
# Thinking on/off is an experimental factor: set it explicitly, never by default.
# TARGET_EXTRA_BODY_JSON={"thinking": {"type": "disabled"}}
