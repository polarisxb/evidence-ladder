# MailBot-specific overrides (optional).
# Shared config is in the project root .env — see ../../.env.example
#
# Load order: this file first, then the root .env fills in anything missing.
# Only MailBot reads this file; the backend judge keeps using the root .env.
# That is how the target model and the judge can come from different vendors
# at the same time (e.g. GLM target + DeepSeek judge). Copy to .env and fill in.
#
# Vendor endpoints (all OpenAI-compatible, function calling supported):
#   DeepSeek : https://api.deepseek.com                       deepseek-v4-flash | deepseek-v4-pro
#   Zhipu GLM: https://open.bigmodel.cn/api/paas/v4           glm-4-flash-250414 (free) | glm-4.7-flash (free) | glm-5.3
#   Qwen     : https://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
#                                                              qwen3.5-flash | qwen3.5-plus-2026-04-20
#   OpenRouter: https://openrouter.ai/api/v1                  <vendor>/<model> slugs
# Model IDs drift; check the vendor's current docs before a recorded run.

# --- Target model (the AI under test) ---
OPENAI_API_KEY=your-target-vendor-key
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
TARGET_MODEL=glm-4-flash-250414

# Vendor-specific request fields merged into every chat/completions body.
# DeepSeek V4 / Qwen3.5 default to thinking mode and need it disabled explicitly;
# GLM-4-Flash has no thinking switch, so leave this unset for it.
# TARGET_EXTRA_BODY_JSON={"thinking": {"type": "disabled"}}

# PORT=8003
