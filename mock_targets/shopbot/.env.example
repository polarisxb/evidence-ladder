# ShopBot-specific overrides (optional).
# Shared config is in the project root .env — see ../../.env.example
#
# Any variable set here overrides the root .env value.
# Only uncomment if you need a ShopBot-specific override, e.g. when the target
# model must come from a different vendor than the backend judge.

# OPENAI_API_KEY=sk-your-target-vendor-key
# OPENAI_BASE_URL=https://api.deepseek.com
# TARGET_MODEL=deepseek-v4-flash
# TARGET_EXTRA_BODY_JSON={"thinking": {"type": "disabled"}}
# PORT=8002
